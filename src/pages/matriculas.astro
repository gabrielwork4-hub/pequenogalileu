---
import BaseLayout from '../components/BaseLayout.astro';
import Callout from '../components/Callout.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<BaseLayout title="Matrículas | O Pequeno Galileu" description="Inicie seu interesse em uma vaga no O Pequeno Galileu e agende uma visita à escola."><section class="page-hero"><div class="container"><p class="eyebrow">MATRÍCULAS</p><h1>O primeiro passo para conhecer a escola.</h1><p>O processo começa com uma conversa e uma visita para que a família possa conhecer o espaço, a proposta e a rotina.</p><a class="button" href={`${base}agendar-visita`}>Quero agendar uma visita</a></div></section><section class="section sand"><div class="container grid-3">{['Converse conosco','Conheça a escola','Siga com orientação'].map((title,index) => <article class="card"><div class="icon">0{index+1}</div><h2>{title}</h2><p>{['Envie seu interesse pelo formulário ou WhatsApp.','Visite os espaços e converse com a coordenação.','Receba as informações e documentos necessários.'][index]}</p></article>)}</div></section><Callout /></BaseLayout>
