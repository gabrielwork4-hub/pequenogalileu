import BaseLayout from '../components/BaseLayout.astro';
import { site } from '../data/site';
---
<BaseLayout title="Contato e localização | O Pequeno Galileu" description="Encontre O Pequeno Galileu no Rio Pequeno e veja os canais que serão confirmados com a escola."><section class="section"><div class="container"><p class="eyebrow">Rio Pequeno, São Paulo</p><h1>Contato e localização</h1><p class="lead">O endereço abaixo foi encontrado no perfil público da escola; complemento, CEP, horário e canais serão validados no briefing.</p><div class="grid-3"><article class="card"><h2>Endereço</h2><p>{site.address}</p><a class="text-link" href="https://www.google.com/maps/search/?api=1&query=Rua+Miguel+Sev%C3%ADlio+175+Rio+Pequeno+S%C3%A3o+Paulo" target="_blank" rel="noopener noreferrer">Abrir rota no mapa</a></article><article class="card"><h2>Atendimento</h2><p>Horários de atendimento e períodos escolares a confirmar com a equipe.</p></article><article class="card"><h2>Canais</h2><p>Telefone, WhatsApp e e-mail serão divulgados após confirmação. Os valores em desenvolvimento são provisórios e não estão ativos nesta prévia.</p></article></div><p class="note">As informações operacionais e o formulário de visita ainda estão em revisão.</p></div></section></BaseLayout>
