---
import BaseLayout from '../components/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Callout from '../components/Callout.astro';
import { programs } from '../data/site';
export function getStaticPaths() { return Object.keys(programs).map((program) => ({ params: { program } })); }
const key = Astro.params.program as keyof typeof programs;
const program = programs[key];
if (!program) return Astro.redirect('/404');
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const titles = { bercario: 'Berçário no Rio Pequeno', maternal: 'Escola maternal no Rio Pequeno', 'pre-escola': 'Pré-escola no Rio Pequeno' };
---
<BaseLayout title={`${titles[key]} | O Pequeno Galileu`} description={`Conheça o ${program.title.toLowerCase()} de O Pequeno Galileu, no Rio Pequeno. Entenda a etapa, a rotina e como solicitar uma visita.`}>
  <div class="container"><Breadcrumbs items={[{label:program.title}]} /></div>
  <section class="page-hero"><div class="container page-hero-grid"><div><p class="eyebrow">{program.age} · Informação provisória</p><h1>{titles[key]}</h1><p>{program.intro}</p><a class="button" href={`${base}agendar-visita`}>Solicitar uma visita</a></div><div class="page-aside"><strong>Para conhecer de perto</strong><p>Converse com a equipe sobre o grupo, veja os ambientes e tire dúvidas sobre o dia da criança.</p></div></div></section>
  <section class="section"><div class="container content-grid"><div><h2>O cotidiano da etapa</h2><p>{program.daily}</p><p><a class="text-link" href={`${base}rotina-e-cuidados`}>Entenda a rotina e os cuidados</a></p></div><div><h2>Brincadeiras e descobertas</h2><p>{program.experience}</p><p><a class="text-link" href={`${base}proposta-pedagogica`}>Conheça a proposta pedagógica</a></p></div></div></section>
  <section class="section sand"><div class="container content-grid"><div><h2>O que vale perguntar na visita</h2><ul class="question-list">{program.questions.map((question) => <li>{question}</li>)}</ul></div><div class="visit-panel"><h3>Veja os espaços da escola</h3><p>As imagens atuais são ilustrativas. As fotos dos ambientes do Galileu serão incluídas após a seleção e autorização de uso.</p><a class="text-link" href={`${base}estrutura-e-espacos`}>Conhecer os espaços</a></div></div></section>
  <section class="section"><div class="container"><div class="section-header"><h2>Próximos passos</h2><p>Veja como funciona a conversa sobre vagas, períodos e matrícula. A equipe pode orientar sua família conforme a etapa da criança.</p><a class="text-link" href={`${base}matriculas`}>Entenda o processo de matrícula</a></div></div></section>
  <Callout title={`Conheça o ${program.title.toLowerCase()} em uma visita.`} text="A equipe pode mostrar os espaços e explicar como organiza o cotidiano deste grupo." />
</BaseLayout>
