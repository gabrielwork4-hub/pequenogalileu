---
import BaseLayout from '../components/BaseLayout.astro';
import Callout from '../components/Callout.astro';
import { programs, posts, site } from '../data/site';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const schema = { '@context':'https://schema.org', '@type':'Preschool', name:site.name, url:site.url, address:{'@type':'PostalAddress', addressLocality:'São Paulo', addressRegion:'SP', addressCountry:'BR'}, areaServed:['Rio Pequeno','Butantã','São Paulo'] };
---
<BaseLayout title="O Pequeno Galileu | Educação Infantil no Rio Pequeno" description="Berçário, maternal e pré-escola no Rio Pequeno. Conheça uma proposta de educação infantil acolhedora e agende uma visita." schema={schema}>
  <section class="hero"><div class="container hero-grid"><div><span class="trust-chip"><span aria-hidden="true">✦</span> Educação infantil no Rio Pequeno</span><p class="eyebrow">DESCOBRIR O MUNDO, COM TEMPO PARA SER CRIANÇA</p><h1>Onde seu filho é acolhido pelo nome e descobre o mundo em seu próprio ritmo.</h1><p class="lead">Berçário, Maternal e Pré-escola em uma jornada feita de presença, curiosidade e cuidado.</p><div class="hero-actions"><a class="button" href={`${base}agendar-visita`}>Agendar visita com a coordenação</a><a class="button secondary" href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener noreferrer">Falar pelo WhatsApp</a></div></div><div class="hero-art"><img src={`${base}images/mocks/home-mock-1.jpg`} width="768" height="960" alt="Imagem ilustrativa provisória de ambiente infantil" loading="eager" /><div class="hero-proof"><strong>Uma escolha feita com calma.</strong><span>Conheça os espaços e converse com nossa coordenação.</span></div></div></div></section>
  <section class="highlights-strip" aria-label="Destaques da escola"><div class="container highlights-grid"><p><strong>Berçário, Maternal e Pré-escola</strong><span>Do primeiro vínculo às primeiras descobertas.</span></p><p><strong>Presença que acolhe</strong><span>Família e escola em diálogo próximo.</span></p><p><strong>Ambientes de descoberta</strong><span>Uma escola na escala da infância.</span></p></div></section>
  <section class="enrollment-band"><div class="container enrollment-grid"><div class="enrollment-year" aria-hidden="true">2027</div><div><p class="eyebrow">MATRÍCULAS 2027</p><h2>O próximo ano começa com uma boa escolha.</h2><p>Conheça os espaços, converse com a coordenação e receba uma orientação feita para a sua família.</p><div class="hero-actions"><a class="button light" href={`${base}matriculas`}>Conhecer o processo</a><a class="button outline-light" href={`${base}agendar-visita`}>Agendar visita</a></div></div></div></section>
  <section class="section"><div class="container"><div class="section-header"><p class="eyebrow">CICLOS DE DESENVOLVIMENTO</p><h2>Uma escola que acompanha cada fase da infância.</h2><p>Conheça os ambientes e as experiências pensadas para os diferentes momentos do desenvolvimento.</p></div><div class="grid-3">{Object.entries(programs).map(([slug, item]) => <article class="card program-card"><span class="age">{item.age}</span><h3>{item.title}</h3><p>{item.description}</p><a href={`${base}${slug}`}>Conhecer {item.title.toLowerCase()} →</a></article>)}</div></div></section>
  <section class="section sand"><div class="container grid-2"><div><p class="eyebrow">CUIDADO E INTENCIONALIDADE</p><h2>Os pilares que sustentam o cotidiano escolar.</h2><p class="lead">Cada encontro, ambiente e rotina pode ser uma oportunidade de desenvolvimento.</p></div><div class="pillars"><div class="pillar"><span>01</span><h3>Vínculo</h3><p>Relações de confiança que acolhem a criança e sua família.</p></div><div class="pillar"><span>02</span><h3>Autonomia</h3><p>Espaços e experiências na escala da infância.</p></div><div class="pillar"><span>03</span><h3>Descoberta</h3><p>Investigação, movimento e brincar como linguagem.</p></div><div class="pillar"><span>04</span><h3>Parceria</h3><p>Diálogo próximo para acompanhar cada etapa.</p></div></div></div></section>
  <section class="section"><div class="container"><div class="section-header"><p class="eyebrow">CADERNO PEDAGÓGICO</p><h2>Reflexões para acompanhar a primeira infância.</h2></div><div class="grid-3">{posts.map((post) => <article class="card article-card"><small>{post.category} · {post.minutes} de leitura</small><h3>{post.title}</h3><p>{post.excerpt}</p><a class="read" href={`${base}blog/${post.slug}`}>Ler artigo →</a></article>)}</div></div></section>
  <Callout />
</BaseLayout>
