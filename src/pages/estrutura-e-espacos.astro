---
import BaseLayout from '../components/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Callout from '../components/Callout.astro';
const areas = [['Entrada e acolhimento','A chegada é um momento de encontro e escuta entre escola, criança e família.'],['Ambientes na escala infantil','Materiais e mobiliário devem convidar a criança a explorar com autonomia.'],['Higiene e alimentação','Rotinas cuidadosas e claras são parte essencial do bem-estar.'],['Movimento e natureza','O brincar, o corpo e o contato com o ambiente ampliam repertórios.']];
---
<BaseLayout title="Estrutura e espaços | O Pequeno Galileu" description="Conheça os espaços que acolhem, protegem e favorecem a descoberta das crianças no O Pequeno Galileu."><div class="container"><Breadcrumbs items={[{label:'Estrutura e espaços'}]} /></div><section class="page-hero"><div class="container"><p class="eyebrow">ESTRUTURA E ESPAÇOS</p><h1>Espaços que acolhem o corpo e libertam a curiosidade.</h1><p>Uma infraestrutura pensada para que a criança explore, brinque e construa autonomia com segurança.</p></div></section><section class="section"><div class="container"><div class="grid-2">{areas.map(([title,text], index) => <article class="card"><div class="icon">0{index + 1}</div><h2>{title}</h2><p>{text}</p><div class="mock-image" style="margin-top:1.5rem;aspect-ratio:16/9"><img src={`/images/mocks/home-mock-${(index % 4) + 1}.jpg`} width="768" height="432" alt={`Imagem ilustrativa provisória de ${title.toLowerCase()}`} loading="lazy" /></div></article>)}</div></div></section><Callout title="Venha sentir o espaço de perto." text="Agende uma visita para conhecer os ambientes e conversar com a coordenação." /></BaseLayout>
