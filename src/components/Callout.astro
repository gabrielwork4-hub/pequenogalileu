---
import { site } from '../data/site';
interface Props { title?: string; text?: string }
const { title = 'Venha nos conhecer de perto', text = 'Uma conversa tranquila e uma visita ao espaço ajudam a família a encontrar a escola certa.' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<section class="callout"><div class="container callout-inner"><div><p class="eyebrow">Conheça a escola</p><h2>{title}</h2><p>{text}</p></div><div class="cta-stack"><a class="button" href={`${base}agendar-visita`}>Solicitar uma visita</a><a class="button secondary" href={site.contactReady ? `https://wa.me/${site.whatsapp}` : `${base}contato`} rel={site.contactReady ? 'noopener noreferrer' : undefined} target={site.contactReady ? '_blank' : undefined}>{site.contactReady ? 'Falar pelo WhatsApp' : 'Ver contato e endereço'}</a></div></div></section>
