---
import { navigation, site } from '../data/site';
const path = Astro.url.pathname;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const currentPath = path.startsWith(base) ? `/${path.slice(base.length)}` : path;
const withBase = (href: string) => `${base}${href.replace(/^\//, '')}`;
---
<header class="site-header">
  <div class="utility"><div class="container"><span>{site.city}</span><span>{site.openingHours}</span></div></div>
  <div class="nav-wrap container">
    <a class="brand" href={base} aria-label="Página inicial de O Pequeno Galileu"><span class="brand-mark">G</span><span><b>O Pequeno Galileu</b><small>Educação infantil</small></span></a>
    <nav aria-label="Navegação principal">{navigation.map((item) => <a class:list={[{ active: currentPath === item.href }]} href={withBase(item.href)}>{item.label}</a>)}</nav>
    <a class="button compact" href={withBase('/agendar-visita')}>Agendar visita</a>
  </div>
</header>
