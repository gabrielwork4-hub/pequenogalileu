---
import { navigation, site } from '../data/site';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const withBase = (href: string) => `${base}${href.replace(/^\//, '')}`;
---
<footer>
  <div class="container footer-grid">
    <div><a class="brand" href={base}><span class="brand-mark">G</span><span><b>O Pequeno Galileu</b><small>Educação infantil</small></span></a><p>Uma escola para a primeira infância, feita de afeto, escuta e descoberta.</p></div>
    <div><h2>Navegação</h2><ul>{navigation.map((item) => <li><a href={withBase(item.href)}>{item.label}</a></li>)}<li><a href={withBase('/matriculas')}>Matrículas</a></li></ul></div>
    <div><h2>Contato</h2><p>{site.address}</p><p><a href={`tel:${site.phone.replace(/\D/g, '')}`}>{site.phone}</a><br/><a href={`mailto:${site.email}`}>{site.email}</a></p></div>
  </div>
  <div class="container footer-bottom">© {new Date().getFullYear()} {site.name}. <a href={withBase('/privacidade')}>Privacidade</a> · <a href={withBase('/termos-de-uso')}>Termos</a></div>
</footer>
