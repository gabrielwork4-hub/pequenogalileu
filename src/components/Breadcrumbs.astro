---
interface Crumb { label: string; href?: string }
interface Props { items: Crumb[] }
const { items } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const withBase = (href: string) => `${base}${href.replace(/^\//, '')}`;
---
<nav class="breadcrumbs" aria-label="Caminho de navegação"><a href={base}>Início</a>{items.map((item) => <><span aria-hidden="true">/</span>{item.href ? <a href={withBase(item.href)}>{item.label}</a> : <span>{item.label}</span>}</>)}</nav>
